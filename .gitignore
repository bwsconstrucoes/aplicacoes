# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv-teste/
venv/

# Segredos — nunca versionar. A credencial mora na Environment do Render.
.env
*.env
.env.*
*.pem
*.p12
*.pfx
*.key
credentials*.json
service_account*.json

# OS
.DS_Store

# Logs/IDE
*.log
.idea/
.vscode/

# Exportação local do Pipefy (dado de cliente, não versionar)
app/apps/erp/export_pipefy/

# ---------------------------------------------------------------------------
# Painel OMIE — dado nao entra no Git (ver README do modulo).
# Espelho do OMIE, cache e exportacoes sao regenerados pela sincronizacao;
# o que o usuario digita (prestacao de contas) vai para o Postgres, nao aqui.
# ---------------------------------------------------------------------------
app/apps/painel/*.db
app/apps/painel/*.db-shm
app/apps/painel/*.db-wal
app/apps/painel/*.parquet
app/apps/painel/*.xlsx
app/apps/painel/*.csv
app/apps/painel/amostra_api.json
app/apps/painel/credenciais.json

# ---------------------------------------------------------------------------
# Analise de SPs — o modulo pesa 217 MB no PC e so 1 MB e codigo.
# O .gitignore de dentro da pasta ja barra tudo isto; a repeticao aqui e
# proposital: se aquele arquivo for apagado por engano, 216 MB de ambiente,
# base e credencial entrariam no historico — e do historico nao se tira.
# A base vem da planilha SPsBD e vive no Postgres do ERP, nao em arquivo.
# ---------------------------------------------------------------------------
app/apps/analisesps/.venv/
app/apps/analisesps/runtime/
app/apps/analisesps/secrets/
app/apps/analisesps/data/
app/apps/analisesps/*.bat
app/apps/analisesps/*.zip
app/apps/analisesps/**/*.db
app/apps/analisesps/**/*.db-shm
app/apps/analisesps/**/*.db-wal
app/apps/analisesps/**/credenciais.json
app/apps/analisesps/**/.streamlit/secrets.toml
